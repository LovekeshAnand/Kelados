{
  "manifest_version": 3,
  "name": "Kelados – Voice Dictation",
  "short_name": "Kelados",
  "version": "1.0.0",
  "description": "Speak into Google Docs, Gmail, Notion and any text box. Speech is recognised on your device: free and private.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Dictate with Kelados (Alt+Shift+D)", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Start or stop dictation in this tab" }
  },
  "externally_connectable": {
    "matches": ["https://kelados.in/*", "http://localhost/*"]
  }
}
