{
  "name": "kelados",
  "version": "1.0.1",
  "description": "Free, unlimited, open-source text-to-speech that runs on your own machine. SDK, CLI, and a drop-in compatible local server.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
